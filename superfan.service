[Unit]
Description=Superfan - temperature-driven fan control for Supermicro servers
Documentation=https://github.com/lancealot/superfan
After=systemd-modules-load.service
ConditionPathExists=/etc/superfan/config.yaml

[Service]
Type=notify
ExecStart=/usr/bin/superfan run
# Runs after every stop, including a crash or a kill: makes sure the BMC has the fans back.
ExecStopPost=-/usr/bin/superfan release
Restart=on-failure
RestartSec=10
# 78 is a configuration error; restarting cannot fix that.
RestartPreventExitStatus=78
# The daemon pings systemd twice per cycle. If the pings stop, systemd kills it and ExecStopPost runs.
WatchdogSec=120
TimeoutStartSec=120
TimeoutStopSec=90
# /run/superfan holds the status file `superfan status` reads and the BMC's previous fan mode.
RuntimeDirectory=superfan
RuntimeDirectoryPreserve=yes

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
